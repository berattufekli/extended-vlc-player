{
  "extends": "expo-module-scripts/tsconfig.base",
  "compilerOptions": {
    "outDir": "build",
    "rootDir": "src",
    "declaration": true,
    "jsx": "react-native",
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*"],
  "exclude": ["__tests__", "build", "node_modules"]
}
